     private double[] sampleGroundNoise(ChunkPos chunkPos) {
+        if (lwSettings.type() == LostWorldType.SPHERES && lwSettings.hasCustomSea()) {
+            // getGroundLevel computes -15 + value / GROUND_SCALE, so store the encoded height
+            double[] heights = new double[256];
+            for (int x = 0; x < 16; x++) {
+                for (int z = 0; z < 16; z++) {
+                    heights[x + z * 16] = (SeaFloor.height(chunkPos.getMinBlockX() + x, chunkPos.getMinBlockZ() + z) + 15) * (double) GROUND_SCALE;
+                }
+            }
+            return heights;
+        }
         return groundNoise.getRegion(null, chunkPos.getMinBlockX(), chunkPos.getMinBlockZ(), 16, 16, 1.0 / 16.0, 1.0 / 16.0, 1.0D);
     }
 
