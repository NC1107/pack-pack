+    /**
+     * Under the sea floor: sand for SeaFloor.SAND_DEPTH blocks so there is nothing to carve into
+     * around domes and no bedrock showing on slopes, then bedrock.
+     */
+    private BlockState groundBlock(int y, int ground, int minBuildHeight, BlockState bedrock, BlockState defaultBlock) {
+        if (lwSettings.type() != LostWorldType.SPHERES || !lwSettings.hasCustomSea()) {
+            return y < minBuildHeight + 2 ? bedrock : defaultBlock;
+        }
+        return y < minBuildHeight + 2 || y < ground - SeaFloor.SAND_DEPTH ? bedrock : Blocks.SAND.defaultBlockState();
+    }
