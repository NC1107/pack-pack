+     * air rooms there, which would stay as air pockets in the water, so this runs last and
+     * floods any air below the sea level that is not inside an enabled sphere. Grass there turns
+     * to moss, since it has been underwater for a long time.
+     */
+    private static void floodOutsideSpheres(LostCityTerrainFeature feature, CitySphere sphere, int chunkX, int chunkZ) {
+        IDimensionInfo provider = feature.provider;
+        Integer outerSeaLevel = outerSeaLevel(feature);
+        if (outerSeaLevel == null) {
+            return;
+        }
+        int seaLevel = Math.min(outerSeaLevel, provider.getWorld().getMaxBuildHeight() - 1);
+        int minY = provider.getWorld().getMinBuildHeight();
+        ChunkDriver driver = feature.getDriver();
+        boolean enabled = sphere.isEnabled() && sphere.getCenterPos() != null;
+        BlockPos cc = enabled ? sphere.getCenterPos() : BlockPos.ZERO;
+        double sqradius = enabled ? sphere.getRadius() * sphere.getRadius() : 0;
+        for (int x = 0; x < 16; x++) {
+            double dx = (chunkX << 4) + x - cc.getX();
+            for (int z = 0; z < 16; z++) {
+                double dz = (chunkZ << 4) + z - cc.getZ();
+                driver.current(x, minY, z);
+                boolean openBelow = false;
