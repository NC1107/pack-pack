+        int minY = feature.provider.getWorld().getMinBuildHeight();
+        int height = seaLevel - minY + 1;
+        boolean[] solid = new boolean[16 * 16 * height];
+        boolean[] supported = new boolean[solid.length];
+        java.util.ArrayDeque<Integer> queue = new java.util.ArrayDeque<>();
+        for (int x = 0; x < 16; x++) {
+            for (int z = 0; z < 16; z++) {
+                for (int y = 0; y < height; y++) {
+                    BlockState state = driver.getBlock(x, y + minY, z);
