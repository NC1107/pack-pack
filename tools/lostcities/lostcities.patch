+    /**
+     * A monorail joins the nearest enabled sphere on each side of this chunk on a grid row or
+     * column. Spheres are not allowed near spawn, so a tube that would pass through the spawn
+     * free area is not built at all (instead of ending in open stubs at its edge).
+     */
+    private static boolean monorailCrossesSpawn(LostCityProfile profile, int fixedChunk, int a, int b) {
+        if (profile.CITY_SPAWN_DISTANCE1 <= 0) {
+            return false;
+        }
+        double lo = Math.min(a, b) * 16.0;
+        double hi = Math.max(a, b) * 16.0;
+        double along = (lo <= 0 && hi >= 0) ? 0 : Math.min(Math.abs(lo), Math.abs(hi));
+        double across = fixedChunk * 16.0;
+        return Math.sqrt(along * along + across * across) < profile.CITY_SPAWN_DISTANCE1;
+    }
