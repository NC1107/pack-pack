+    /**
+     * Under an outer sea (Lost Worlds with a custom sea level) everything outside the domes is
+     * meant to be ocean. Buildings, drowned cities and structures generated earlier can leave
+     * air rooms there, which would stay as air pockets in the water, so this runs last and
+     * floods any air below the sea level that is not inside an enabled sphere. Grass there turns
+     * to moss, since it has been underwater for a long time.
+     */
+    private static void floodOutsideSpheres(LostCityTerrainFeature feature, CitySphere sphere, int chunkX, int chunkZ) {
+        IDimensionInfo provider = feature.provider;
+        Integer outerSeaLevel = outerSeaLevel(feature);
+        if (outerSeaLevel == null) {
+            return;
+        }
+        int seaLevel = Math.min(outerSeaLevel, provider.getWorld().getMaxBuildHeight() - 1);
+        int minY = provider.getWorld().getMinBuildHeight();
+        ChunkDriver driver = feature.getDriver();
+        boolean enabled = sphere.isEnabled() && sphere.getCenterPos() != null;
+        BlockPos cc = enabled ? sphere.getCenterPos() : BlockPos.ZERO;
+        double sqradius = enabled ? sphere.getRadius() * sphere.getRadius() : 0;
+        for (int x = 0; x < 16; x++) {
+            double dx = (chunkX << 4) + x - cc.getX();
+            for (int z = 0; z < 16; z++) {
+                double dz = (chunkZ << 4) + z - cc.getZ();
+                driver.current(x, minY, z);
+                for (int y = minY; y <= seaLevel; y++) {
+                    double dy = y - cc.getY();
+                    if (!enabled || dx * dx + dy * dy + dz * dz > sqradius) {
+                        BlockState state = driver.getBlock();
+                        if (state.isAir()) {
+                            driver.block(feature.liquid);
+                        } else if (state.is(Blocks.GRASS_BLOCK)) {
+                            // Lawns of drowned cities have been under the sea for a long time
+                            driver.block(Blocks.MOSS_BLOCK.defaultBlockState());
+                        }
+                    }
+                    driver.incY();
+                }
+            }
+        }
+    }
+
+    private static final int LIGHT_SPACING = 6;
+    private static final int LIGHT_HEIGHT = 3;
+    private static final BlockState LIGHT = Blocks.LIGHT.defaultBlockState();
+
+    /**
+     * Under an outer sea no daylight reaches a dome, so its streets would be dark at noon. This
+     * places invisible light blocks a few blocks above whatever is on top of the ground (street,
+     * lawn or roof) on a regular grid inside the dome. Light blocks are replaceable, so they never
+     * get in the way of building.
+     */
+    private static void lightSphere(LostCityTerrainFeature feature, CitySphere sphere, int chunkX, int chunkZ) {
+        if (!sphere.isEnabled() || sphere.getCenterPos() == null || outerSeaLevel(feature) == null) {
+            return;
+        }
+        ChunkDriver driver = feature.getDriver();
+        BlockPos cc = sphere.getCenterPos();
+        double radius = sphere.getRadius() - 2;
+        for (int x = Math.floorMod(LIGHT_SPACING / 2 - (chunkX << 4), LIGHT_SPACING); x < 16; x += LIGHT_SPACING) {
+            double dx = (chunkX << 4) + x - cc.getX();
+            for (int z = Math.floorMod(LIGHT_SPACING / 2 - (chunkZ << 4), LIGHT_SPACING); z < 16; z += LIGHT_SPACING) {
+                double dz = (chunkZ << 4) + z - cc.getZ();
+                double up = radius * radius - dx * dx - dz * dz;
+                if (up <= 0) {
+                    continue;
+                }
+                int top = cc.getY() + (int) Math.sqrt(up);
+                int floor = cc.getY() - 2;
+                int y = top;
+                while (y >= floor && driver.getBlock(x, y, z).isAir()) {
+                    y--;
+                }
+                int light = y + LIGHT_HEIGHT;
+                if (y >= floor && light < top && driver.getBlock(x, light, z).isAir()) {
+                    driver.current(x, light, z).block(LIGHT);
+                }
+            }
+        }
+    }
+
+    private static Integer outerSeaLevel(LostCityTerrainFeature feature) {
+        IDimensionInfo provider = feature.provider;
+        ChunkGenerator generator;
+        if (provider.getWorld() instanceof WorldGenRegion region) {
+            generator = ((ServerChunkCache) region.getChunkSource()).getGenerator();
+        } else {
+            generator = ((ServerLevel) provider.getWorld()).getChunkSource().getGenerator();
+        }
+        return generator instanceof ILostWorldsChunkGenerator lw ? lw.getOuterSeaLevel() : null;
+    }
